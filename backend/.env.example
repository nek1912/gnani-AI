# Backend configuration — single source of truth (read by absolute path).
# Copy to backend/.env and fill in real values. Never commit real credentials.

# ── Required ──
GROQ_API_KEY=
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
JINA_API_KEY=

# ── Optional (voice) ──
SARVAM_API_KEY=
SARVAM_API_KEY_2=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── Optional (Gnani AI — STT Prisma v3.0 + TTS Timbre v3.0) ──
# Server-side only. Never exposed to the frontend (no VITE_ prefix).
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_STT_TIMEOUT_S=30
GNANI_TTS_TIMEOUT_S=30
GNANI_STT_OUTPUT_FORMAT=verbatim
GNANI_STT_AUTO_DETECT=true

# ── Optional (translation) ──
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=

# ── Optional (web RAG) ──
TAVILY_API_KEY_1=
TAVILY_API_KEY_2=
FIRECRAWL_API_KEY=
SERPAPI_API_KEY_1=
SERPAPI_API_KEY_2=
SEARCH_PROVIDERS=tavily
WEB_RAG_TIMEOUT_S=90

# ── Auth (required for chat/voice/grievance-write) ──
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_ISSUER=

# ── CORS ──
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Model IDs ──
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash

# ── Feature flags ──
RERANKER_ENABLED=false
CITATION_REPAIR_ENABLED=true
ANSWER_GROUNDING_LLM_ENABLED=false

# ── Timeouts ──
REQUEST_TIMEOUT_S=15
LLM_TIMEOUT_S=12
